# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for local dev — no Docker required).
# The file is created automatically on first migrate/seed.
# For production Postgres, use: DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=./dev.db

# ── Session ───────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-char-string

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Email provider ────────────────────────────────────────────────────────────
# Options: mock | resend | sendgrid | postmark | ses
# Use "mock" in local dev — OTP codes are printed to stdout.
EMAIL_PROVIDER=mock

# ── Resend (required when EMAIL_PROVIDER=resend) ──────────────────────────────
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# ── SMS provider ──────────────────────────────────────────────────────────────
# Options: mock | twilio | vonage
SMS_PROVIDER=mock

# ── Twilio (required when SMS_PROVIDER=twilio) ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Payment provider ──────────────────────────────────────────────────────────
# Options: mock | stripe
# Use "mock" in local dev — subscription state set via POST /api/v1/dev/simulate-webhook
PAYMENT_PROVIDER=mock

# ── Stripe (required when PAYMENT_PROVIDER=stripe) ───────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed for widget embed requests (no credentials)
CORS_WIDGET_ORIGINS=http://localhost:5173,http://localhost:3000
# Dashboard origin — used for CORS (with credentials) and CSRF cookie matching
CORS_DASHBOARD_ORIGIN=http://localhost:3000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Logging ───────────────────────────────────────────────────────────────────
# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Used for BOTH Google sign-in and the native Google Sheets lead integration.
# 1. Go to console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application type)
# 3. Add BOTH of these as Authorized redirect URIs:
#      http://localhost:4000/api/v1/auth/google/callback
#      http://localhost:4000/api/v1/integrations/google-sheets/callback
# 4. For the Sheets integration, enable the "Google Sheets API" for the project
#    and add the .../auth/spreadsheets scope on the OAuth consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
# Redirect URI for the Google Sheets integration flow (offline access + Sheets scope).
GOOGLE_SHEETS_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google-sheets/callback

# ── Scheduled jobs ────────────────────────────────────────────────────────────
# Bearer token to protect /api/v1/cron/* endpoints in production.
# Optional in development. Example: openssl rand -hex 32
CRON_SECRET=
